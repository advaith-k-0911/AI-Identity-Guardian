# AI Identity Guardian - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# NEVER commit the actual .env file with real secrets to version control.

# Application Settings
ENVIRONMENT=development
DEBUG=True
APP_NAME="AI Identity Guardian"
APP_VERSION="0.1.0"
API_V1_STR="/api/v1"

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Security & CORS
# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Database Configuration (PostgreSQL compatible; SQLite default for local development)
DATABASE_URL="sqlite:///./ai_identity_guardian.db"

# Future Security Module Settings (Not active in Phase 1)
# SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
# ACCESS_TOKEN_EXPIRE_MINUTES=60
