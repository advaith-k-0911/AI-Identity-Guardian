[TEMPLATE]
# AI Identity Guardian - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# NEVER commit the actual .env file with real secrets to version generation.

# Application Settings
ENVIRONMENT=development
DEBUG=True
APP_NAME="AI Identity Guardian"
APP_VERSION="0.1.0"
API_V1_STR="/api/v1"

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Security & CORS
# Comma-separated list of allowed origins
# In production, set to your frontend domain only (e.g. "https://yourdomain.com")
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Database Configuration (PostgreSQL recommended for production)
DATABASE_URL="sqlite:///./ai_identity_guardian.db"

# JWT Secret Key - REQUIRED for production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Never use the same key across environments
SECRET_KEY=""

# AI Explanation Settings (optional)
# GEMINI_API_KEY="your-gemini-api-key-here"
# AI_PROVIDER="auto"
